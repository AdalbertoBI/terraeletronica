{
  "name": "terra-eletronica-site",
  "version": "1.0.0.2.9",
  "description": "Site oficial da Terra Eletrônica - Produtos Especiais para Pessoas Especiais",
  "main": "index.html",
  "scripts": {
    "start": "npx live-server --port=3000 --open=/index.html",
    "build": "npm run minify-css && npm run minify-js",
    "minify-css": "npx clean-css-cli -o assets/css/style.min.css assets/css/style.css",
    "minify-js": "npx terser assets/js/main.js -c -m -o assets/js/main.min.js",
    "optimize-images": "npx imagemin assets/images/**/*.{jpg,jpeg,png} --out-dir=assets/images/optimized",
    "lint": "npx eslint assets/js/main.js",
    "validate-html": "npx html-validate *.html produtos/*.html",
    "lighthouse": "npx lighthouse http://localhost:3000 --output-path=./lighthouse-report.html",
    "version:patch": "python update-version.py --type patch",
    "version:minor": "python update-version.py --type minor",
    "version:major": "python update-version.py --type major",
    "version:build": "python update-version.py --type build",
    "version:revision": "python update-version.py --type revision",
  "version:sync": "python update-version.py --sync-from-sw",
    "version:show": "python update-version.py --show-current",
    "cache:clear": "echo 'Abra o console do navegador e execute: cacheManager.clearCache()'"
  },
  "keywords": [
    "tecnologia assistiva",
    "acessibilidade",
    "instrumentos musicais",
    "mouses especiais",
    "lupas eletrônicas",
    "inclusão digital",
    "deficiência",
    "musicoterapia",
    "terra eletrônica"
  ],
  "author": "Terra Eletrônica",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/terra-eletronica/site-oficial.git"
  },
  "homepage": "https://terra-eletronica.github.io/site-oficial",
  "devDependencies": {
    "clean-css-cli": "^5.6.2",
    "eslint": "^8.55.0",
    "html-validate": "^8.7.4",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2",
    "lighthouse": "^11.4.0",
    "live-server": "^1.2.2",
    "terser": "^5.26.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}